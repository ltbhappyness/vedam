{{ generated_c }}
#include "vi/class/{{ cls.name }}.h"
#include "vii/class/{{ cls.name }}.h"
#include "vii/dispatch.h"
{% for v in cls.public_verbs %}

/**
 * @brief Build the internal {{ v.verb.name }} call for {{ cls.name }} and dispatch it.
 *
 * @param[in,out] msg Call message
 * @return The dispatch status.
 */
v_status_t vi_{{ cls.name }}_{{ v.verb.name }}(vi_msg_t *msg)
{
    vii_msg_t call;

    if (msg == NULL) {
        return V_STATUS_INVALID_PARAMETER;
    }
{% if cls.singleton %}
    msg->key = NULL;
    msg->key_len = 0;
{% endif %}
    call.class_id = V_CLASS_{{ cls.ident }};
    call.origin = V_ORIGIN_EXTERNAL;
    call.verb = {{ v.verb.c_ident }};
    call.major = VII_{{ cls.ident }}_MAJOR;
    call.minor = VII_{{ cls.ident }}_MINOR;
    call.msg = msg;
    return vii_dispatch(&call);
}
{% endfor %}
