{{ generated_c }}
#include "vi/class/{{ class_name }}.h"
#include "vii/class/{{ class_name }}.h"

#include "vti/dispatch.h"
{% for name in public_verbs %}
{% if name == "get" %}

/**
 * @brief Public get for {{ class_name }}. Enters vii through the local transport.
 *
 * @param[in,out] msg Call message
 * @return The vii status.
 */
v_status_t vi_{{ class_name }}_get(vi_msg_t *msg)
{
    vta_msg_t call;

    if (msg == NULL) {
        return V_STATUS_INVALID_PARAMETER;
    }
{% if singleton %}
    msg->key = NULL;
    msg->key_len = 0;
{% endif %}
    call.class_id = V_CLASS_{{ class_ident }};
    call.origin = V_ORIGIN_EXTERNAL;
    call.verb = V_VERB_GET;
    call.major = VII_{{ class_ident }}_MAJOR;
    call.minor = VII_{{ class_ident }}_MINOR;
    call.msg = msg;
    return vta_dispatch(&call);
}
