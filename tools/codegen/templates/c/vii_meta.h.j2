/**
 * @brief Return the row for @p id in @p cls, or NULL when the class does not define it.
 *
 * @param[in] cls Class row
 * @param[in] id  Attribute id
 * @return The attribute row, or NULL.
 */
static inline const struct vii_attr_meta *vii_attr_lookup(const struct vii_class *cls,
                                                          v_attr_id_t id)
{
    vuint8_t row;

    if (cls->attr_by_id == NULL || id > cls->attr_id_max) {
        return NULL;
    }
    row = cls->attr_by_id[id];
    if (row == 0) {
        return NULL;
    }
    return &cls->attrs[row - 1];
}

