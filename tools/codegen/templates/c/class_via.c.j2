/**
 * @brief Check one attribute value against its meta type and verb.
 *
 * @param[in] m     Attribute meta row
 * @param[in] attr  Attribute value
 * @param[in] verb  Verb being checked
 * @param[in] index Attribute index in the caller's list
 * @return V_STATUS_SUCCESS or an indexed invalid-value status.
 */
static v_status_t check_value(const struct via_attr_meta *m, const v_attr_t *attr, int verb,
                              vint32_t index)
{
    if (m->type_kind == VIA_T_TRANSPORT) {
        const vta_desc_t *tr = (const vta_desc_t *)attr->value.ptr;
        if (verb == V_VERB_CREATE && (tr == NULL || tr->ops == NULL)) {
            return (v_status_t)(V_STATUS_INVALID_ATTR_VALUE_0 - index);
        }
    }
    if (m->type_kind == VIA_T_PTR && verb == V_VERB_GET && attr->value.ptr == NULL) {
        return (v_status_t)(V_STATUS_INVALID_ATTR_VALUE_0 - index);
    }
    if (m->type_kind == VIA_T_TEXT && attr->value.text.len > 0 && attr->value.text.buf == NULL) {
        return (v_status_t)(V_STATUS_INVALID_ATTR_VALUE_0 - index);
    }
    return V_STATUS_SUCCESS;
}

/**
 * @brief Visit every attribute, write status_list[i], and return the first failure.
 *
 * Does not return on the first failure. When every entry is success, checks
 * mandatory-on-create attributes for create.
 *
 * @param[in]     origin Call origin
 * @param[in,out] msg    Call message with attr_list and status_list
 * @param[in]     verb   Verb being checked
 * @return V_STATUS_SUCCESS or the first non-success per-attribute code.
 */
static v_status_t check_list(v_origin_t origin, vi_msg_t *msg, int verb)
{
    vuint32_t i;
    const struct via_attr_meta *m;
    v_status_t st;
    v_status_t first;

    first = V_STATUS_SUCCESS;
    for (i = 0; i < msg->attr_count; i++) {
        m = via_attr_find({{ class_name }}_meta, VIA_{{ class_ident }}_ATTR_COUNT,
                          msg->attr_list[i].id);
        if (m == NULL) {
            st = (v_status_t)(V_STATUS_UNKNOWN_ATTRIBUTE_0 - (vint32_t)i);
        } else if (origin == V_ORIGIN_EXTERNAL && !m->is_public) {
            st = (v_status_t)(V_STATUS_ATTR_NOT_SUPPORTED_0 - (vint32_t)i);
        } else if (origin == V_ORIGIN_EXTERNAL && (verb == V_VERB_SET || verb == V_VERB_CREATE) &&
                   (m->flags & VIA_F_READ_ONLY)) {
            st = (v_status_t)(V_STATUS_ATTR_NOT_SUPPORTED_0 - (vint32_t)i);
        } else if (verb == V_VERB_SET && (m->flags & VIA_F_CREATE_ONLY)) {
            st = (v_status_t)(V_STATUS_ATTR_NOT_SUPPORTED_0 - (vint32_t)i);
        } else if (verb == V_VERB_CREATE && (m->flags & VIA_F_SET_ONLY)) {
            st = (v_status_t)(V_STATUS_ATTR_NOT_SUPPORTED_0 - (vint32_t)i);
        } else if ((verb == V_VERB_SUBSCRIBE || verb == V_VERB_UNSUBSCRIBE || verb == V_VERB_NOTIFY) &&
                   !(m->flags & VIA_F_SUBSCRIBABLE)) {
            st = (v_status_t)(V_STATUS_ATTR_NOT_SUPPORTED_0 - (vint32_t)i);
        } else {
            st = check_value(m, &msg->attr_list[i], verb, (vint32_t)i);
        }
        msg->status_list[i] = st;
        if (st != V_STATUS_SUCCESS && first == V_STATUS_SUCCESS) {
            first = st;
        }
    }
    if (first != V_STATUS_SUCCESS) {
        return first;
    }
    if (verb == V_VERB_CREATE) {
        vuint32_t j;

        for (j = 0; j < VIA_{{ class_ident }}_ATTR_COUNT; j++) {
            if (!({{ class_name }}_meta[j].flags & VIA_F_MANDATORY_ON_CREATE)) {
                continue;
            }
            for (i = 0; i < msg->attr_count; i++) {
                if (msg->attr_list[i].id == {{ class_name }}_meta[j].id) {
                    break;
                }
            }
            if (i == msg->attr_count) {
                return V_STATUS_MANDATORY_ATTR_MISSING;
            }
        }
    }
    return V_STATUS_SUCCESS;
}

/**
 * @brief Require attr_list and status_list together when attr_count is non-zero.
 *
 * @param[in] msg Call message
 * @return V_STATUS_SUCCESS or V_STATUS_INVALID_PARAMETER.
 */
static v_status_t require_msg_lists(const vi_msg_t *msg)
{
    if (msg == NULL) {
        return V_STATUS_INVALID_PARAMETER;
    }
    if (msg->attr_count != 0 && (msg->attr_list == NULL || msg->status_list == NULL)) {
        return V_STATUS_INVALID_PARAMETER;
    }
    return V_STATUS_SUCCESS;
}

