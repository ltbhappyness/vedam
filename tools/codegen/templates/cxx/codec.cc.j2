/**
 * @brief Map a library status to a protobuf StatusCode without collapsing errors.
 *
 * @param[in] st Library status
 * @return Matching StatusCode, including indexed-attribute families.
 */
static vedam::StatusCode to_proto_code(v_status_t st)
{
    if (st == V_STATUS_SUCCESS) {
        return vedam::STATUS_OK;
    }
    if (st == V_STATUS_FAILURE) {
        return vedam::STATUS_FAILURE;
    }
    if (st == V_STATUS_NOT_SUPPORTED) {
        return vedam::STATUS_NOT_SUPPORTED;
    }
    if (st == V_STATUS_NO_MEMORY) {
        return vedam::STATUS_NO_MEMORY;
    }
    if (st == V_STATUS_INVALID_PARAMETER) {
        return vedam::STATUS_INVALID_PARAMETER;
    }
    if (st == V_STATUS_ITEM_ALREADY_EXISTS) {
        return vedam::STATUS_ITEM_ALREADY_EXISTS;
    }
    if (st == V_STATUS_ITEM_NOT_FOUND) {
        return vedam::STATUS_ITEM_NOT_FOUND;
    }
    if (st == V_STATUS_BUFFER_OVERFLOW) {
        return vedam::STATUS_BUFFER_OVERFLOW;
    }
    if (st == V_STATUS_MANDATORY_ATTR_MISSING) {
        return vedam::STATUS_MANDATORY_ATTR_MISSING;
    }
    if (st == V_STATUS_UNINITIALIZED) {
        return vedam::STATUS_UNINITIALIZED;
    }
    if (st == V_STATUS_NOT_IMPLEMENTED) {
        return vedam::STATUS_NOT_IMPLEMENTED;
    }
    if (st == V_STATUS_FAILED_PRECONDITION) {
        return vedam::STATUS_FAILED_PRECONDITION;
    }
    if (st == V_STATUS_CAPABILITY_DENIED) {
        return vedam::STATUS_CAPABILITY_DENIED;
    }
    if (st == V_STATUS_OFFLINE) {
        return vedam::STATUS_OFFLINE;
    }
    if (st == V_STATUS_THERMAL_SHED) {
        return vedam::STATUS_THERMAL_SHED;
    }
    if (st == V_STATUS_OBJECT_IN_USE) {
        return vedam::STATUS_OBJECT_IN_USE;
    }
    if (st <= V_STATUS_INVALID_ATTR_VALUE_0 && st > V_STATUS_INVALID_ATTR_VALUE_0 - 1000) {
        return vedam::STATUS_INVALID_ATTR_VALUE;
    }
    if (st <= V_STATUS_ATTR_NOT_IMPLEMENTED_0 && st > V_STATUS_ATTR_NOT_IMPLEMENTED_0 - 1000) {
        return vedam::STATUS_ATTR_NOT_IMPLEMENTED;
    }
    if (st <= V_STATUS_UNKNOWN_ATTRIBUTE_0 && st > V_STATUS_UNKNOWN_ATTRIBUTE_0 - 1000) {
        return vedam::STATUS_UNKNOWN_ATTRIBUTE;
    }
    if (st <= V_STATUS_ATTR_NOT_SUPPORTED_0 && st > V_STATUS_ATTR_NOT_SUPPORTED_0 - 1000) {
        return vedam::STATUS_ATTR_NOT_SUPPORTED;
    }
    if (st <= V_STATUS_INVALID_ATTR_ID_0 && st > V_STATUS_INVALID_ATTR_ID_0 - 1000) {
        return vedam::STATUS_INVALID_ATTR_ID;
    }
    return vedam::STATUS_FAILURE;
}

/**
 * @brief Map a protobuf StatusCode back to a library status.
 *
 * @param[in] code       Wire status code
 * @param[in] attr_index Zero-based attribute index for indexed families
 * @return Matching v_status_t.
 */
static v_status_t from_proto_code(vedam::StatusCode code, int attr_index)
{
    switch (code) {
    case vedam::STATUS_OK:
        return V_STATUS_SUCCESS;
    case vedam::STATUS_FAILURE:
        return V_STATUS_FAILURE;
    case vedam::STATUS_NOT_SUPPORTED:
        return V_STATUS_NOT_SUPPORTED;
    case vedam::STATUS_NO_MEMORY:
        return V_STATUS_NO_MEMORY;
    case vedam::STATUS_INVALID_PARAMETER:
        return V_STATUS_INVALID_PARAMETER;
    case vedam::STATUS_ITEM_ALREADY_EXISTS:
        return V_STATUS_ITEM_ALREADY_EXISTS;
    case vedam::STATUS_ITEM_NOT_FOUND:
        return V_STATUS_ITEM_NOT_FOUND;
    case vedam::STATUS_BUFFER_OVERFLOW:
        return V_STATUS_BUFFER_OVERFLOW;
    case vedam::STATUS_MANDATORY_ATTR_MISSING:
        return V_STATUS_MANDATORY_ATTR_MISSING;
    case vedam::STATUS_UNINITIALIZED:
        return V_STATUS_UNINITIALIZED;
    case vedam::STATUS_NOT_IMPLEMENTED:
        return V_STATUS_NOT_IMPLEMENTED;
    case vedam::STATUS_FAILED_PRECONDITION:
        return V_STATUS_FAILED_PRECONDITION;
    case vedam::STATUS_CAPABILITY_DENIED:
        return V_STATUS_CAPABILITY_DENIED;
    case vedam::STATUS_OFFLINE:
        return V_STATUS_OFFLINE;
    case vedam::STATUS_THERMAL_SHED:
        return V_STATUS_THERMAL_SHED;
    case vedam::STATUS_OBJECT_IN_USE:
        return V_STATUS_OBJECT_IN_USE;
    case vedam::STATUS_INVALID_ATTR_VALUE:
        return (v_status_t)(V_STATUS_INVALID_ATTR_VALUE_0 - attr_index);
    case vedam::STATUS_ATTR_NOT_IMPLEMENTED:
        return (v_status_t)(V_STATUS_ATTR_NOT_IMPLEMENTED_0 - attr_index);
    case vedam::STATUS_UNKNOWN_ATTRIBUTE:
        return (v_status_t)(V_STATUS_UNKNOWN_ATTRIBUTE_0 - attr_index);
    case vedam::STATUS_ATTR_NOT_SUPPORTED:
        return (v_status_t)(V_STATUS_ATTR_NOT_SUPPORTED_0 - attr_index);
    case vedam::STATUS_INVALID_ATTR_ID:
        return (v_status_t)(V_STATUS_INVALID_ATTR_ID_0 - attr_index);
    default:
        return V_STATUS_FAILURE;
    }
}

/**
 * @brief Store one attribute value into a protobuf Attr by type kind.
 *
 * @param[in]  class_id Class index
 * @param[in]  src      Source attribute
 * @param[out] dst      Protobuf attribute
 * @return 0 on success, -1 when the kind is unknown.
 */
static int put_attr_value(v_class_id_t class_id, const v_attr_t *src, vedam::Attr *dst)
{
    int kind;

    kind = vta_attr_kind(class_id, src->id);
    dst->set_id(src->id);
    if (kind == VIA_T_S32) {
        dst->mutable_value()->set_s32(src->value.s32);
    } else if (kind == VIA_T_BOOL) {
        dst->mutable_value()->set_booldata(src->value.booldata != 0);
    } else if (kind == VIA_T_VERSION) {
        vedam::Version *ver = dst->mutable_value()->mutable_version();

        ver->set_major(src->value.version.major);
        ver->set_minor(src->value.version.minor);
    } else if (kind == VIA_T_TEXT) {
        if (src->value.text.buf != NULL && src->value.text.len > 0) {
            dst->mutable_value()->set_text(src->value.text.buf, src->value.text.len);
        } else {
            dst->mutable_value()->set_text("");
        }
    } else if (kind == VIA_T_PTR) {
        vuint32_t nbytes;

        nbytes = vta_attr_ptr_size(class_id, src->id);
        if (src->value.ptr != NULL && nbytes > 0) {
            dst->mutable_value()->set_blob(src->value.ptr, nbytes);
        } else {
            dst->mutable_value()->set_blob("");
        }
    } else if (kind < 0) {
        /* Unknown id crosses the wire so VIA can reject it. */
    } else {
        return -1;
    }
    return 0;
}

/**
 * @brief Load one attribute value from a protobuf Attr into caller memory.
 *
 * @param[in]     class_id Class index
 * @param[in]     src      Protobuf attribute
 * @param[in,out] dst      Destination attribute (text/ptr buffers already set)
 * @return 0 on success, -1 when the value cannot be copied.
 */
static int take_attr_value(v_class_id_t class_id, const vedam::Attr &src, v_attr_t *dst)
{
    int kind;

    kind = vta_attr_kind(class_id, src.id());
    dst->id = src.id();
    if (kind == VIA_T_S32) {
        dst->value.s32 = src.value().s32();
    } else if (kind == VIA_T_BOOL) {
        dst->value.booldata = src.value().booldata() ? 1 : 0;
    } else if (kind == VIA_T_VERSION) {
        dst->value.version.major = src.value().version().major();
        dst->value.version.minor = src.value().version().minor();
    } else if (kind == VIA_T_TEXT) {
        const std::string &text = src.value().text();

        if (dst->value.text.buf == NULL) {
            return -1;
        }
        if (text.size() > 0) {
            vplatform_memcpy(dst->value.text.buf, text.data(), text.size());
        }
        dst->value.text.len = (vuint32_t)text.size();
    } else if (kind == VIA_T_PTR) {
        const std::string &blob = src.value().blob();
        vuint32_t nbytes;

        nbytes = vta_attr_ptr_size(class_id, src.id());
        if (dst->value.ptr == NULL) {
            return -1;
        }
        if (nbytes > 0) {
            if (blob.size() < nbytes) {
                vplatform_memset(dst->value.ptr, 0, nbytes);
                if (!blob.empty()) {
                    vplatform_memcpy(dst->value.ptr, blob.data(), blob.size());
                }
            } else {
                vplatform_memcpy(dst->value.ptr, blob.data(), nbytes);
            }
        }
    } else if (kind < 0) {
        /* Unknown id: keep id only so VIA can reject it. */
    } else {
        return -1;
    }
    return 0;
}

/**
 * @brief Fill a protobuf Message from @p msg and @p overall.
 *
 * @param[in]  class_id Class index
 * @param[in]  msg      Public message
 * @param[in]  overall  Overall status
 * @param[out] wire     Protobuf message
 * @return V_STATUS_SUCCESS, or V_STATUS_INVALID_PARAMETER on a bad attribute.
 */
static v_status_t fill_message(v_class_id_t class_id, const vi_msg_t *msg, v_status_t overall,
                               vedam::Message *wire)
{
    vuint32_t i;
    int rc;

    wire->Clear();
    if (msg->key != NULL && msg->key_len > 0) {
        wire->set_key(msg->key, msg->key_len);
    }
    wire->mutable_status()->set_code(to_proto_code(overall));
    wire->mutable_status()->set_vedam_status(static_cast<int32_t>(overall));
    for (i = 0; i < msg->attr_count; i++) {
        vedam::Attr *dst = wire->add_attrs();
        v_status_t st;

        rc = put_attr_value(class_id, &msg->attr_list[i], dst);
        if (rc != 0) {
            return V_STATUS_INVALID_PARAMETER;
        }
        st = msg->status_list != NULL ? msg->status_list[i] : V_STATUS_SUCCESS;
        dst->mutable_status()->set_code(to_proto_code(st));
        dst->mutable_status()->set_vedam_status(static_cast<int32_t>(st));
    }
    return V_STATUS_SUCCESS;
}

/**
 * @brief Copy a protobuf Message into @p msg.
 *
 * @param[in]     class_id     Class index
 * @param[in]     wire         Protobuf message
 * @param[in,out] msg          Public message (arrays sized on entry)
 * @param[out]    overall      Overall status
 * @param[out]    key_buf      Server key copy, or NULL
 * @param[in]     key_cap      Capacity of @p key_buf
 * @param[in]     preserve_key Non-zero to leave msg->key unchanged
 * @return V_STATUS_SUCCESS, or a failure when counts or values are bad.
 */
static v_status_t drain_message(v_class_id_t class_id, const vedam::Message &wire, vi_msg_t *msg,
                                v_status_t *overall, uint8_t *key_buf, size_t key_cap,
                                int preserve_key)
{
    int n;
    int i;
    int rc;

    n = wire.attrs_size();
    if (n < 0 || (vuint32_t)n > msg->attr_count) {
        return V_STATUS_BUFFER_OVERFLOW;
    }
    if ((vuint32_t)n > 0 && (msg->attr_list == NULL || msg->status_list == NULL)) {
        return V_STATUS_INVALID_PARAMETER;
    }
    if (!preserve_key) {
        if (wire.key().size() > 0) {
            if (key_buf == NULL || wire.key().size() > key_cap) {
                return V_STATUS_BUFFER_OVERFLOW;
            }
            vplatform_memcpy(key_buf, wire.key().data(), wire.key().size());
            msg->key = key_buf;
            msg->key_len = (vuint32_t)wire.key().size();
        } else {
            msg->key = NULL;
            msg->key_len = 0;
        }
    }
    for (i = 0; i < n; i++) {
        const vedam::Attr &src = wire.attrs(i);

        rc = take_attr_value(class_id, src, &msg->attr_list[i]);
        if (rc != 0) {
            return V_STATUS_INVALID_PARAMETER;
        }
        msg->status_list[i] = (v_status_t)src.status().vedam_status();
        if (msg->status_list[i] == V_STATUS_SUCCESS &&
            src.status().code() != vedam::STATUS_OK &&
            src.status().code() != vedam::STATUS_CODE_UNSPECIFIED) {
            msg->status_list[i] = from_proto_code(src.status().code(), i);
        }
    }
    msg->attr_count = (vuint32_t)n;
    *overall = (v_status_t)wire.status().vedam_status();
    if (*overall == V_STATUS_SUCCESS && wire.status().code() != vedam::STATUS_OK &&
        wire.status().code() != vedam::STATUS_CODE_UNSPECIFIED) {
        *overall = from_proto_code(wire.status().code(), 0);
    }
    return V_STATUS_SUCCESS;
}

