/**
 * @brief Parse a verb path segment into @p verb.
 *
 * @param[in]  name Verb path segment
 * @param[out] verb Receives the verb id
 * @return V_STATUS_SUCCESS, or V_STATUS_NOT_IMPLEMENTED when unknown.
 */
extern "C" v_status_t vta_codec_verb_parse(const char *name, v_verb_t *verb)
{
    if (name == NULL || verb == NULL) {
        return V_STATUS_INVALID_PARAMETER;
    }
    if (std::strcmp(name, "Get") == 0) {
        *verb = V_VERB_GET;
        return V_STATUS_SUCCESS;
    }
    if (std::strcmp(name, "Subscribe") == 0) {
        *verb = V_VERB_SUBSCRIBE;
        return V_STATUS_SUCCESS;
    }
    if (std::strcmp(name, "Unsubscribe") == 0) {
        *verb = V_VERB_UNSUBSCRIBE;
        return V_STATUS_SUCCESS;
    }
    if (std::strcmp(name, "Create") == 0) {
        *verb = V_VERB_CREATE;
        return V_STATUS_SUCCESS;
    }
    if (std::strcmp(name, "Set") == 0) {
        *verb = V_VERB_SET;
        return V_STATUS_SUCCESS;
    }
    if (std::strcmp(name, "Delete") == 0) {
        *verb = V_VERB_DELETE;
        return V_STATUS_SUCCESS;
    }
    if (std::strcmp(name, "Notify") == 0) {
        *verb = V_VERB_NOTIFY;
        return V_STATUS_SUCCESS;
    }
    return V_STATUS_NOT_IMPLEMENTED;
}

/**
 * @brief Encode @p msg as a protobuf Message into @p buf.
 *
 * @param[in]  class_id Class index used for attribute type kinds
 * @param[in]  msg      Public message to encode
 * @param[in]  overall  Overall status written into Message.status
 * @param[out] buf      Connection-owned output buffer
 * @param[in]  cap      Capacity of @p buf
 * @param[out] out_len  Encoded byte count
 * @param[in,out] ws    Connection-owned codec workspace
 * @return V_STATUS_SUCCESS, or a failure when the message does not fit.
 */
extern "C" v_status_t vta_codec_encode(v_class_id_t class_id, const vi_msg_t *msg, v_status_t overall,
                                       uint8_t *buf, size_t cap, size_t *out_len, vta_codec_ws_t *ws)
{
    v_status_t st;
    size_t n;

    if (msg == NULL || buf == NULL || out_len == NULL || ws == NULL || ws->wire == NULL) {
        return V_STATUS_INVALID_PARAMETER;
    }
    if (msg->attr_count > 0 && (msg->attr_list == NULL || msg->status_list == NULL)) {
        return V_STATUS_INVALID_PARAMETER;
    }

    ws->recycle();
    st = fill_message(class_id, msg, overall, ws->wire);
    if (st != V_STATUS_SUCCESS) {
        return st;
    }

    n = ws->wire->ByteSizeLong();
    if (n > cap) {
        return V_STATUS_BUFFER_OVERFLOW;
    }
    if (!ws->wire->SerializeToArray(buf, static_cast<int>(n))) {
        return V_STATUS_FAILURE;
    }
    *out_len = n;
    return V_STATUS_SUCCESS;
}

/**
 * @brief Decode a protobuf Message into @p msg.
 *
 * @param[in]     class_id     Class index used for attribute type kinds
 * @param[in]     buf          Encoded Message bytes
 * @param[in]     len          Length of @p buf
 * @param[in,out] msg          Public message to fill
 * @param[out]    overall      Overall status from Message.status
 * @param[in,out] ws           Connection-owned codec workspace
 * @param[out]    key_buf      Server-side key copy buffer, or NULL when unused
 * @param[in]     key_cap      Capacity of @p key_buf
 * @param[in]     preserve_key Non-zero to leave the caller's key pointer alone
 * @return V_STATUS_SUCCESS, or a failure when the frame is bad.
 */
extern "C" v_status_t vta_codec_decode(v_class_id_t class_id, const uint8_t *buf, size_t len,
                                       vi_msg_t *msg, v_status_t *overall, vta_codec_ws_t *ws,
                                       uint8_t *key_buf, size_t key_cap, int preserve_key)
{
    if (msg == NULL || overall == NULL || ws == NULL || ws->wire == NULL) {
        return V_STATUS_INVALID_PARAMETER;
    }
    if (buf == NULL && len != 0) {
        return V_STATUS_INVALID_PARAMETER;
    }

    ws->recycle();
    if (!ws->wire->ParseFromArray(buf, static_cast<int>(len))) {
        return V_STATUS_INVALID_PARAMETER;
    }
    return drain_message(class_id, *ws->wire, msg, overall, key_buf, key_cap, preserve_key);
}

/**
 * @brief Serve one HTTP verb using connection-owned @p mem and @p out_buf.
 *
 * @param[in]  class_name  Hyphenated vertical UUID from the path
 * @param[in]  verb_name   Verb path segment
 * @param[in]  body        Request body bytes (grpc frame already stripped)
 * @param[in]  body_len    Length of @p body
 * @param[out] out_buf     Connection-owned response buffer
 * @param[in]  out_cap     Capacity of @p out_buf
 * @param[out] out_len     Response byte count including the five-byte prefix
 * @param[out] grpc_status Static digit string for the trailer
 * @param[in,out] mem      Connection-owned codec memory
 * @return 0 when a response was produced, -1 when the body cannot be read.
 */
extern "C" int vta_codec_http(const char *class_name, const char *verb_name, const uint8_t *body,
                              size_t body_len, uint8_t *out_buf, size_t out_cap, size_t *out_len,
                              const char **grpc_status, struct vta_codec_mem *mem)
{
    uint8_t uuid[VTA_CLASS_UUID_LEN];
    vi_msg_t vim;
    vta_msg_t call;
    v_class_id_t class_id;
    vuint32_t major;
    vuint32_t minor;
    v_verb_t verb;
    v_status_t st;
    v_status_t overall;
    size_t payload_len;
    size_t framed_len;
    vuint32_t i;
    int kind;

    if (class_name == NULL || verb_name == NULL || out_buf == NULL || out_len == NULL ||
        grpc_status == NULL || mem == NULL || mem->ws == NULL) {
        return -1;
    }
    if (body == NULL && body_len != 0) {
        return -1;
    }
    *out_len = 0;
    *grpc_status = "12";

    st = vta_class_uuid_parse(class_name, uuid);
    if (st != V_STATUS_SUCCESS) {
        return 0;
    }

    st = vta_class_from_uuid(uuid, &class_id, &major, &minor);
    if (st != V_STATUS_SUCCESS) {
        return 0;
    }

    st = vta_codec_verb_parse(verb_name, &verb);
    if (st != V_STATUS_SUCCESS) {
        return 0;
    }

    vplatform_memset(&vim, 0, sizeof(vim));
    vplatform_memset(&call, 0, sizeof(call));
    vplatform_memset(mem->attrs, 0, sizeof(mem->attrs));
    vplatform_memset(mem->statuses, 0, sizeof(mem->statuses));
    vim.attr_count = VTA_CODEC_MAX_ATTR;
    vim.attr_list = mem->attrs;
    vim.status_list = mem->statuses;
    for (i = 0; i < VTA_CODEC_MAX_ATTR; i++) {
        mem->attrs[i].value.ptr = mem->scratch[i];
        mem->attrs[i].value.text.buf = (char *)mem->scratch[i];
        mem->attrs[i].value.text.len = 0;
    }

    st = vta_codec_decode(class_id, body == NULL ? (const uint8_t *)"" : body, body_len, &vim,
                          &overall, mem->ws, mem->key, sizeof(mem->key), 0);
    if (st != V_STATUS_SUCCESS) {
        return -1;
    }

    /* Re-point text/ptr buffers after decode overwrote union members for scalars. */
    for (i = 0; i < vim.attr_count; i++) {
        kind = vta_attr_kind(class_id, mem->attrs[i].id);
        if (kind == VIA_T_PTR) {
            mem->attrs[i].value.ptr = mem->scratch[i];
        } else if (kind == VIA_T_TEXT) {
            mem->attrs[i].value.text.buf = (char *)mem->scratch[i];
            mem->attrs[i].value.text.len = 0;
        }
    }

    call.class_id = class_id;
    call.origin = V_ORIGIN_EXTERNAL;
    call.verb = verb;
    call.major = major;
    call.minor = minor;
    call.msg = &vim;
    overall = vta_dispatch(&call);

    if (out_cap < 5u) {
        return -1;
    }
    st = vta_codec_encode(class_id, &vim, overall, out_buf + 5, out_cap - 5u, &payload_len,
                          mem->ws);
    if (st != V_STATUS_SUCCESS) {
        return -1;
    }

    st = vta_codec_grpc_frame(out_buf, out_cap, payload_len, &framed_len);
    if (st != V_STATUS_SUCCESS) {
        return -1;
    }
    *out_len = framed_len;
    *grpc_status = vta_codec_grpc_digits(overall);
    return 0;
}
