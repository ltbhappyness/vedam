{{ generated_proto }}
syntax = "proto3";

package {{ package }}.v1;

option java_multiple_files = true;
option java_package = "org.ltbh.{{ package }}.v1";
option go_package = "github.com/ltbhappyness/vedam-interface/{{ package }}/v1;{{ package }}v1";

import "google/protobuf/any.proto";
import "google/protobuf/descriptor.proto";

extend google.protobuf.FileOptions {
  bytes namespace_uuid = 50001;
}

extend google.protobuf.ServiceOptions {
  bytes vertical_uuid = 50000;
  uint32 vertical_minor = 50003;
}

extend google.protobuf.EnumValueOptions {
  AttrRules attr = 50002;
}

option (namespace_uuid) = "{{ vedam_uuid_ns_proto_esc }}";

message Version {
  uint32 major = 1;
  uint32 minor = 2;
}

enum StatusCode {
{% for line in proto_status_lines %}
{{ line }}
{% endfor %}
}

message Status {
  StatusCode code = 1;
  string message = 2;
  sint32 vedam_status = 3;
}

message AttrValue {
  reserved 7;
  reserved "blob";

  oneof kind {
    bool booldata = 1;
    int32 s32 = 2;
    uint32 u32 = 3;
    uint64 u64 = 4;
    Version version = 5;
    bytes text = 6;
    google.protobuf.Any message = 8;
    ListValue list = 9;
  }
}

/**
 * The items of a list attribute, in order. Each item uses the AttrValue field
 * of the item kind named in that attribute's AttrRules.
 */
message ListValue {
  repeated AttrValue items = 1;
}

message Attr {
  uint32 id = 1;
  AttrValue value = 2;
  Status status = 3;
}

/**
 * One call. The request and the response are this message.
 *
 * key is the object key. Leave it empty when the vertical has one object.
 * attrs is the attribute list. Set Attr.id to an attribute enum from that vertical.
 * A repeated id keeps the last entry.
 * On a get, leave Attr.value empty. The response fills it.
 * Attr.status is that attribute's result. Every attribute is visited.
 * status is the overall result: success only when every Attr.status
 * succeeded, otherwise the first failure.
 */
message Message {
  bytes key = 1;
  repeated Attr attrs = 2;
  Status status = 3;
}

/**
 * The rules one attribute follows, attached to each attribute enum value.
 *
 * kind is the value shape: {{ kinds | map(attribute="name") | join(", ") }}.
 * type is the protobuf type of the value, or of one item for a LIST: an enum or
 * message in that vertical's file, or a shared protobuf type. When has_range is
 * true, a written value or item is from min to max. When max_len is not zero, a
 * written text is at most that many bytes.
 * flags lists the public flags, each explained on the attribute.
 */
message AttrRules {
  string kind = 1;
  string type = 2;
  bool has_range = 3;
  sint64 min = 4;
  sint64 max = 5;
  uint32 max_len = 6;
  repeated string flags = 7;
}
