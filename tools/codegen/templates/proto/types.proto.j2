{{ generated_proto }}
syntax = "proto3";

package vedam;

option java_multiple_files = true;
option java_package = "org.ltbh.vedam";
option go_package = "github.com/ltbhappyness/vedam-interface/vedam";

import "google/protobuf/descriptor.proto";

extend google.protobuf.FileOptions {
  bytes namespace_uuid = 50001;
}

extend google.protobuf.ServiceOptions {
  bytes vertical_uuid = 50000;
}

option (namespace_uuid) = "{{ vedam_uuid_ns_proto_esc }}";

message Version {
  uint32 major = 1;
  uint32 minor = 2;
}

enum StatusCode {
{% for line in proto_status_lines %}
{{ line }}
{% endfor %}
}

message Status {
  StatusCode code = 1;
  string message = 2;
  sint32 vedam_status = 3;
}

message AttrValue {
  oneof kind {
    bool booldata = 1;
    int32 s32 = 2;
    uint32 u32 = 3;
    uint64 u64 = 4;
    Version version = 5;
    bytes text = 6;
    bytes blob = 7;
  }
}

message Attr {
  uint32 id = 1;
  AttrValue value = 2;
  Status status = 3;
}

/**
 * One call. The request and the response are this message.
 *
 * key is the object key. Leave it empty when the vertical has one object.
 * attrs is the attribute list. Set Attr.id to an attribute enum from that vertical.
 * A repeated id keeps the last entry.
 * On a get, leave Attr.value empty. The response fills it.
 * Attr.status is that attribute's result. Every attribute is visited.
 * status is the overall result: success only when every Attr.status
 * succeeded, otherwise the first failure.
 */
message Message {
  bytes key = 1;
  repeated Attr attrs = 2;
  Status status = 3;
}
