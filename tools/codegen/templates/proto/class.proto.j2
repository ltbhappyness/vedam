{{ generated_proto }}
syntax = "proto3";

package {{ pkg.name }};

option java_multiple_files = true;
option java_package = "org.ltbh.{{ pkg.name }}";
option go_package = "github.com/ltbhappyness/vedam-interface/{{ package }}/{{ cls.name }}/v{{ pkg.major }};{{ cls.name }}v{{ pkg.major }}";

import "{{ package }}/v1/types.proto";

{% for line in cls.proto_notes %}
{% if line %}
// {{ line }}
{% else %}
//
{% endif %}
{% endfor %}
{% for e in cls.enums %}

enum {{ e.proto_name }} {
{% for v in e["values"] %}
  {{ v.proto_name }} = {{ v.value }};  // {{ v.comment }}
{% endfor %}
}
{% endfor %}
{% for s in cls.structs %}

message {{ s.proto_name }} {
{% for f in s.wire_fields %}
  {{ f.proto_decl }}  // {{ f.comment }}
{% endfor %}
}
{% endfor %}

enum {{ cls.title }}Attr {
  // No attribute is selected.
  {{ cls.ident }}_ATTR_UNSPECIFIED = 0;
{% for a in cls.public_attrs %}
{% for line in wrap(a.docs("proto")) %}
  // {{ line }}
{% endfor %}
  {{ cls.ident }}_ATTR_{{ a.name }} = {{ a.id }} [({{ package }}.v1.attr) = {
{% for key, value in a.rules %}
    {{ key }}: {{ value }}
{% endfor %}
  }];
{% endfor %}
}

service {{ pkg.service }} {
  option ({{ package }}.v1.vertical_uuid) = "{{ pkg.uuid.proto_esc }}";
  option ({{ package }}.v1.vertical_minor) = {{ pkg.minor }};
{% for v in cls.rpc_verbs %}

{% for line in wrap(v.comment) %}
  // {{ line }}
{% endfor %}
  rpc {{ v.verb.method }}({{ package }}.v1.Message) returns ({{ "stream " if v.stream }}{{ package }}.v1.Message);
{% endfor %}
}
