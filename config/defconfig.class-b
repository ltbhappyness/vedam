VEDAM_NODE_CLASS=B
VEDAM_ENABLE_MQ=y
VEDAM_ENABLE_GRPC=y
VEDAM_ENABLE_GRPC_UDS=y
# VEDAM_ENABLE_CONNECT is not set
VEDAM_ENABLE_CONTRACT=y
# VEDAM_ENABLE_CONTRACT_ENGINE is not set
VEDAM_ENABLE_PLUGIN=y
VEDAM_ENABLE_WWLOCK=y
VEDAM_BUILD_VEDAMD=y
